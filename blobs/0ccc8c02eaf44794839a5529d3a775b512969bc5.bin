nderline; outline: auto; }
  .toctogglecheckbox:checked + .toctitle .toctogglelabel::after { content: =
"show"; }
  .toctogglecheckbox:not(:checked) + .toctitle .toctogglelabel::after { con=
tent: "hide"; }
