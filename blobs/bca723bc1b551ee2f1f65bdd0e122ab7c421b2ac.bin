# Record 1: /home/hase/NES/nes/src/cpu.rs
```diff
===================================================================
--- cpu.rs (before)	snapshot
+++ cpu.rs (after)	idle
@@ -1043,6 +1043,35 @@
         assert_eq!(cpu.mem_read(0x0200), 0x03);
         assert_eq!(cpu.mem_read(0x0201), 0x03);
     }
 
+    #[test]
+    fn test_stack_roundtrip_loop_with_absolute_y_store() {
+        let mut cpu = CPU::new();
 
+        cpu.load_and_run(vec![
+            0xa2, 0x00,       // LDX #$00
+            0xa0, 0x00,       // LDY #$00
+            0x8a,             // firstloop: TXA
+            0x99, 0x00, 0x02, // STA $0200,Y
+            0x48,             // PHA
+            0xe8,             // INX
+            0xc8,             // INY
+            0xc0, 0x10,       // CPY #$10
+            0xd0, 0xf5,       // BNE firstloop
+            0x68,             // secondloop: PLA
+            0x99, 0x00, 0x02, // STA $0200,Y
+            0xc8,             // INY
+            0xc0, 0x20,       // CPY #$20
+            0xd0, 0xf7,       // BNE secondloop
+            0x00,             // BRK
+        ]);
+
+        for i in 0..0x10 {
+            assert_eq!(cpu.mem_read(0x0200 + i), i as u8);
+        }
+
+        for i in 0..0x10 {
+            assert_eq!(cpu.mem_read(0x0210 + i), (0x0f - i) as u8);
+        }
+    }
 }

```

A new test function was added to cpu.rs that initializes the CPU, loads a specific program into memory, runs a nested loop that uses TXA, STA with absolute Y addressing, stack operations PHA and PLA, and finally asserts memory contents to verify correct stack roundtrip handling with absolute Y store.