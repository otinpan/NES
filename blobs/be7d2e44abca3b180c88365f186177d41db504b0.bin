  div.mw-lag-warn-normal { border: 1px solid rgb(255, 204, 102); background=
-color: rgb(255, 255, 204); }
  div.mw-lag-warn-high { font-weight: bold; border: 2px solid rgb(255, 0, 5=
1); background-color: rgb(255, 204, 204); }
  .MediaTransformError { background-color: rgb(170, 170, 170); padding: 0.1=
em; }
  .MediaTransformError td { text-align: center; vertical-align: middle; fon=
t-size: 90%; }
  .tipsy { font-size: 127%; }
