") square; }
  pre, .mw-code { line-height: 1.1em; }
  .firstHeading { margin-top: 0.4em; margin-bottom: 0.1em; padding-top: 0px=
; display: block; }
  .mw-indicators { line-height: 1.5em; font-size: 95%; }
  .mw-indicator { display: inline-block; }
