------MultipartBoundary--fK8Mv9APbNQgRwKoQE2DLyoM7w0MyfRBadiSOZFeON----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://www.nesdev.org/w/load.php?lang=en&modules=site.styles&only=styles&skin=monobook

@charset "utf-8";

table.tabular { margin: 1em 1em 1em 0px; background: rgb(249, 249, 249); bo=
rder: 1px solid rgb(170, 170, 170); border-collapse: collapse; }

table.tabular th, table.tabular td { border: 1px solid rgb(170, 170, 170); =
padding: 0.2em; }

table.tabular th { background: rgb(242, 242, 242); text-align: center; }

table.tabular caption { margin-left: inherit; margin-right: inherit; }

table.oddf0 tr:nth-of-type(2n+1) { background: rgb(240, 240, 240); }

table.evenf0 tr:nth-of-type(2n) { background: rgb(240, 240, 240); }

.ns--2 #content { background-color: rgb(244, 244, 244); }

.ns--2 div.thumb { border-color: rgb(244, 244, 244); }

.ns-4 #content, .ns-5 #content { background-color: rgb(248, 252, 255); }

.ns-4 div.thumb, .ns-5 div.thumb { border-color: rgb(248, 252, 255); }

.ns-8 #content, .ns-9 #content { background-color: rgb(244, 244, 244); }

.ns-8 div.thumb, .ns-9 div.thumb { border-color: rgb(244, 244, 244); }

.ns-100 #content, .ns-101 #content { background-color: rgb(243, 243, 255); =
}

.ns-100 div.thumb, .ns-101 div.thumb { border-color: rgb(243, 243, 255); }

.ns-12 #content { border-top: 2px solid rgb(0, 0, 204); border-bottom: 2px =
solid rgb(0, 0, 204); border-left: 2px solid rgb(0, 0, 204); border-image: =
initial; border-right: none; background-image: url("http://upload.wikimedia=
.org/wikipedia/mediawiki/b/b8/PD-banner.png"); background-repeat: no-repeat=
; background-position: right top; }

.ns-12 #bodyContent { background-image: url("http://upload.wikimedia.org/wi=
kipedia/mediawiki/6/67/PD-icon-faded.png"); background-repeat: no-repeat; b=
ackground-position: right 5em; }

.borderc1 { border-color: rgb(233, 233, 233); border-width: thin; }

.borderc2 { border-color: rgb(170, 170, 170); border-width: thin; }

.borderc3 { border-color: rgb(119, 119, 119); border-width: thin; }

.borderc4 { border-color: rgb(0, 0, 0); border-width: thin; }

.borderc5 { border-color: rgb(192, 0, 0); border-width: thin; }

.borderc6 { border-color: rgb(2, 94, 157); border-width: thin; }

.borderc7 { border-color: rgb(0, 128, 64); border-width: thin; }

.borderc8 { border-color: rgb(255, 204, 0); border-width: thin; }

.backgroundc1 { background-color: rgb(255, 255, 255); }

.backgroundc2 { background-color: rgb(249, 249, 249); }

.backgroundc3 { background-color: rgb(238, 238, 238); }

.backgroundc4 { background-color: rgb(224, 224, 224); }

.backgroundc5 { background-color: rgb(210, 210, 210); }

.backgroundc6 { background-color: rgb(183, 183, 183); }

.backgroundc7 { background-color: rgb(163, 163, 163); }

.backgroundc8 { background-color: rgb(68, 68, 85); }

.SpecialPageInfo { background-color: rgb(249, 249, 249); background-image: =
url("http://upload.wikimedia.org/wikipedia/commons/thumb/8/89/Exquisite-khe=
lpcenter.png/35px-Exquisite-khelpcenter.png"); background-position: 0.8em 0=
.5em; background-repeat: no-repeat; padding: 0.3em 0.5em 0.3em 5em; border-=
color: rgb(2, 94, 157); border-width: 1px 1px medium; border-style: solid; =
margin-bottom: 1em; }

.mw-viewprevnext { display: block; border: 1px solid rgb(204, 204, 204); ba=
ckground-color: rgb(249, 249, 242); padding: 0.2em 0.4em; }

#mainpage_topbox { background: rgb(249, 249, 249); padding: 0px; border: 1p=
x solid rgb(170, 170, 170); margin: 0.2em 10px 10px; }

.mainpage_boxtitle, .mainpage_hubtitle, #mainpage_pagetitle { font-size: 10=
5%; padding: 0.4em; background-color: rgb(238, 238, 238); border-bottom: 1p=
x solid rgb(170, 170, 170); }

.mainpage_boxtitle { line-height: 120%; }

#mainpage_pagetitle { color: rgb(207, 118, 6); font-size: 200% !important; =
}

#mainpage_sitelinks { padding: 0.2em; text-align: center; background-color:=
 white; }

.mainpage_hubtitle { text-align: center; }

.mainpage_boxcontents, .mainpage_boxcontents_small { background: rgb(255, 2=
55, 255); padding: 0.2em 0.4em; }

.mainpage_boxcontents_small { font-size: 95%; }

.mainpage_hubbox, #mainpage_newscell, #mainpage_downloadcell { padding: 0px=
; border: 1px solid rgb(170, 170, 170); }

.mainpage_hubbox { margin-bottom: 0px; }

#mainpage_newscell { margin-bottom: 15px; margin-top: 0px !important; }

#mainpage_newscell .mainpage_boxtitle { background-image: url("http://uploa=
d.wikimedia.org/wikipedia/commons/thumb/8/89/Exquisite-khelpcenter.png/20px=
-Exquisite-khelpcenter.png"); background-repeat: no-repeat; background-posi=
tion: 99% 0.3em; padding-right: 25px; }

#mainpage_downloadcell { width: 17em; margin-bottom: 5px; }

#mainpage_downloadcell .mainpage_boxtitle { background-image: url("http://u=
pload.wikimedia.org/wikipedia/commons/thumb/5/5d/Crystal_Clear_action_build=
.png/18px-Crystal_Clear_action_build.png"); background-repeat: no-repeat; b=
ackground-position: 96% 0.33em; padding-right: 25px; }

#mainpage_mwtitle { color: rgb(0, 82, 136); }

.mainpage #lastmod, .mainpage #siteSub, .mainpage h1.firstHeading { display=
: none !important; }

.mainpage #content { padding-top: 1em; }

#n-blog-text a, #n-browse-svn a, #n-Statistics-for-SVN a, #n-phpdoc a, #n-s=
vn-statistics a { background: url("/skins-1.5/monobook/external.png") right=
 center no-repeat; padding-right: 13px; color: rgb(51, 102, 187); }

.wikitable th, .wikitable td.hl3, .wikitable th.hl3 { background: rgb(141, =
167, 214); }

.wikitable td.hl1, .wikitable th.hl1 { background: rgb(197, 216, 252); }

.wikitable td.hl2, .wikitable th.hl2 { background: rgb(167, 193, 242); }

.vatop tr, tr.vatop, .vatop td, .vatop th { vertical-align: top; }

table.datatable { background-color: transparent; }

table.datatable th, table.datatable td { padding: 4px; }

table.datatable th { text-align: left; background-color: rgb(153, 153, 153)=
; }

table.datatable tr { background-color: rgb(204, 204, 204); }

table.datatable tr:hover { background-color: rgb(255, 255, 204); }

div.sideBox { position: relative; float: right; background: white; margin-l=
eft: 1em; border: 1px solid gray; padding: 0.3em; width: 200px; overflow: h=
idden; clear: right; }

div.sideBox dl { padding: 0px; margin: 0px 0px 0.3em; font-size: 96%; }

div.sideBox dl dt { background: none; margin: 0.4em 0px 0px; }

div.sideBox dl dd { margin: 0.1em 0px 0px 1.1em; background-color: rgb(243,=
 243, 243); }

.ext-infobox { border: 2px solid rgb(170, 170, 170); width: 272px; float: r=
ight; margin: 0px 0px 0.5em 0.5em; border-collapse: collapse; background-co=
lor: white; }

.ext-infobox td { border-top: 2px none rgb(170, 170, 170); border-right: 2p=
x none rgb(170, 170, 170); border-left: 2px none rgb(170, 170, 170); border=
-image: initial; padding: 0.2em 0.5em; border-bottom: 1px solid rgb(240, 24=
0, 240) !important; }

.ext-header { background-color: rgb(170, 170, 170); color: white; text-alig=
n: left; }

.ext-header td { padding-top: 0.5em; }

.ext-header img { padding: 0px 0.2em 0px 0.5em; }

.ext-status-unstable, .ext-status-unstable td { border-color: rgb(153, 0, 0=
); }

.ext-status-unstable .ext-header { background-color: rgb(153, 0, 0); color:=
 rgb(255, 255, 0); }

.ext-status-experimental, .ext-status-experimental td { border-color: rgb(2=
55, 69, 0); }

.ext-status-experimental .ext-header { background-color: rgb(255, 69, 0); }

.ext-status-beta, .ext-status-beta td { border-color: rgb(255, 186, 1); }

.ext-status-beta .ext-header { background-color: rgb(255, 186, 1); }

.ext-status-stable, .ext-status-stable td { border-color: rgb(50, 205, 50);=
 }

.ext-status-stable .ext-header { background-color: rgb(50, 205, 50); }

#DownloadVersionBox { border: 2px solid black; border-collapse: collapse; m=
argin: auto; width: 50%; color: black; }

#DownloadVersionBox td { border: 2px solid black; padding: 20px; }

.majorwarning { background: yellow; padding: 0.3em; text-align: center; fon=
t-size: 125%; border: 2px solid red; }

.page-notice, .page-warning { border-width: 1px; border-style: solid; paddi=
ng: 0.3em 0.5em; margin-bottom: 1em; width: 95%; margin-left: auto; margin-=
right: auto; text-align: center; }

.page-notice { background-color: rgb(249, 249, 249); border-color: rgb(2, 9=
4, 157); text-align: left; }

.page-warning { background-color: rgb(255, 255, 255); border-color: rgb(197=
, 25, 25); border-width: 2px; }

.pw-head { color: rgb(197, 25, 25); font-weight: bold; }

.block-note { background-image: url("http://upload.wikimedia.org/wikipedia/=
commons/thumb/6/60/Bulbgraph.png/18px-Bulbgraph.png"); background-position:=
 left top; background-repeat: no-repeat; }

.block-contents { display: block; padding-left: 20px; }

.template-documentation { clear: both; margin: 1em 0px 0px; border: 1px sol=
id rgb(170, 170, 170); background-color: rgb(236, 252, 244); padding: 5px; =
}

#toc { margin: 1em 0px; }

.toclimit-2 .toclevel-1 ul, .toclimit-3 .toclevel-2 ul, .toclimit-4 .toclev=
el-3 ul, .toclimit-5 .toclevel-4 ul, .toclimit-6 .toclevel-5 ul, .toclimit-=
7 .toclevel-6 ul { display: none; }

ol.references { font-size: 100%; }

.references-small { font-size: 90%; }

ol.references > li:target { background-color: rgb(221, 238, 255); }

sup.reference:target { background-color: rgb(221, 238, 255); }

.my-buttons { padding: 0.5em; }

.my-buttons a { color: black; font-weight: bold; font-size: 0.9em; text-dec=
oration: none; border: thin outset rgb(0, 102, 153); padding: 0px 0.1em 0.1=
em; background-color: rgb(204, 221, 238) !important; }

.my-buttons a:hover, .my-buttons a:active { background-color: rgb(187, 204,=
 221); border-style: inset; }

.imagelink_wikilogo a { width: 135px; height: 135px; display: block; text-d=
ecoration: none; background-image: url("http://upload.wikimedia.org/wikiped=
ia/mediawiki/b/bc/Wiki.png"); }

table.mbox { margin: 4px 10%; border-collapse: collapse; border: 1px solid =
rgb(170, 170, 170); background: rgb(249, 249, 249); }

table.mbox-wide { margin: 4px 0px; }

th.mbox-text, td.mbox-text { border: none; padding: 0.25em 0.9em; width: 10=
0%; }

td.mbox-image { border: none; padding: 2px 0px 2px 0.9em; text-align: cente=
r; }

td.mbox-imageright { border: none; padding: 2px 0.9em 2px 0px; text-align: =
center; }

td.mbox-empty-cell { border: none; padding: 0px; width: 1px; }

body.mediawiki table.mbox-small { clear: right; float: right; margin: 4px 0=
px 4px 1em; width: 238px; font-size: 88%; line-height: 1.25em; }

body.mediawiki table.mbox-small-left { margin: 4px 1em 4px 0px; width: 238p=
x; border-collapse: collapse; font-size: 88%; line-height: 1.25em; }

table.mbox-critical { border: 4px solid rgb(178, 34, 34); background: rgb(2=
55, 219, 219); }

table.mbox-important { background: rgb(255, 219, 219); }

table.mbox-warning { background: rgb(255, 231, 206); }

table.mbox-caution { background: rgb(255, 249, 219); }

table.mbox-notice { background: rgb(216, 232, 255); }

table.mbox-move { background: rgb(228, 216, 255); }

table.mbox-protection { background: rgb(239, 239, 225); }

.infobox { float: right; clear: right; margin-bottom: 0.5em; margin-left: 1=
em; padding: 0.2em; border: 1px solid rgb(170, 170, 170); background: rgb(2=
49, 249, 249); color: black; }

.infobox td, .infobox th { vertical-align: top; }

.infobox caption { margin-left: inherit; font-size: larger; }

.infobox.bordered { border-collapse: collapse; }

.infobox.bordered td, .infobox.bordered th { border: 1px solid rgb(170, 170=
, 170); }

.infobox.bordered .borderless td, .infobox.bordered .borderless th { border=
: 0px; }

.mw-inputbox-hideapicheck label[for=3D"mw-inputbox-ns104"], #mw-inputbox-ns=
104 { display: none; }

div.mw-wordcloud { width: 100%; text-align: justify; }

.mw-wordcloud-size-1 { color: rgb(34, 34, 34); font-size: 2.4em; }

.mw-wordcloud-size-2 { color: rgb(51, 51, 51); font-size: 2.2em; }

.mw-wordcloud-size-3 { color: rgb(68, 68, 68); font-size: 2em; }

.mw-wordcloud-size-4 { color: rgb(85, 85, 85); font-size: 1.8em; }

.mw-wordcloud-size-5 { color: rgb(102, 102, 102); font-size: 1.6em; }

.mw-wordcloud-size-6 { color: rgb(119, 119, 119); font-size: 1.4em; }

.mw-wordcloud-size-7 { color: rgb(136, 136, 136); font-size: 1.2em; }

.mw-wordcloud-size-8 { color: rgb(153, 153, 153); font-size: 1em; }

.mw-wordcloud-size-9 { color: rgb(170, 170, 170); font-size: 0.8em; letter-=
spacing: 3px; }

.mw-wordcloud-size-10, .mw-wordcloud-size-0 { color: rgb(187, 187, 187); fo=
nt-size: 0.8em; }

.rellink, .dablink { font-style: italic; margin-bottom: 0.5em; padding-left=
: 2em; }

#signuptopbox li { float: left; list-style: none; font-family: sans-serif; =
}

#signuptopbox li { color: rgb(60, 167, 212); background: rgb(194, 225, 249)=
; line-height: 2.8em; margin-right: 0.25em; padding-right: 0.5em; }

#signuptopbox li.pr-active, #signuptopbox li.pr-active div { color: rgb(103=
, 202, 54); background: rgb(212, 249, 194); border-color: rgb(255, 255, 255=
) rgb(255, 255, 255) rgb(255, 255, 255) rgb(103, 202, 54); }

#signuptopbox li div { width: 0px; height: 0px; border-color: rgb(255, 255,=
 255) rgb(255, 255, 255) rgb(255, 255, 255) rgb(60, 167, 212); border-style=
: solid; border-width: 1.4em 0.3em 1.4em 1.4em; float: left; }

#signuptopbox li span.pr-number { display: block; width: 1.8em; line-height=
: 1.8em; background: rgb(60, 167, 212); color: rgb(194, 225, 249); text-ali=
gn: center; margin: 0.5em; border-radius: 50%; font-weight: 600; float: lef=
t; }

#signuptopbox li.pr-active span.pr-number { background: rgb(103, 202, 54); =
color: rgb(212, 249, 194); }

#signuptopbox li span { float: left; }

#signuptopbox li.pr-spacer { padding: 0px; }

.breadcrumb { list-style: none; overflow: hidden; font: 14px Helvetica, Ari=
al, sans-serif; }

.breadcrumb li { float: left; margin-bottom: 0px; }

.breadcrumb li a { color: white; text-decoration: none; padding: 10px 0px 1=
0px 45px; position: relative; display: block; float: left; }

.breadcrumb li a::after { content: " "; display: block; width: 0px; height:=
 0px; border-top: 50px solid transparent; border-bottom: 50px solid transpa=
rent; position: absolute; top: 50%; margin-top: -50px; left: 100%; z-index:=
 2; }

.breadcrumb li a::before { content: " "; display: block; width: 0px; height=
: 0px; border-top: 50px solid transparent; border-bottom: 50px solid transp=
arent; border-left: 31px solid white; position: absolute; top: 50%; margin-=
top: -50px; margin-left: 1px; left: 100%; z-index: 1; }

.breadcrumb li:first-child a { padding-left: 20px; }

.currentcrumb a { background: rgb(0, 102, 153); }

.currentcrumb a::after { border-left: 30px solid rgb(0, 102, 153); }

.currentcrumb a:hover, .prevcrumb a:hover, .nextcrumb a:hover { background:=
 rgb(0, 45, 68); }

.currentcrumb a:hover::after, .prevcrumb a:hover::after, .nextcrumb a:hover=
::after { border-left-color: rgb(0, 45, 68) !important; }

.prevcrumb a { background: rgb(51, 153, 102); }

.prevcrumb a::after { border-left: 30px solid rgb(51, 153, 102); }

.nextcrumb a { background: rgb(153, 153, 153); }

.nextcrumb a::after { border-left: 30px solid rgb(153, 153, 153); }

.mw-codereview-diff ins { background: rgb(237, 255, 237); }

.mw-codereview-diff del { background: rgb(255, 237, 237); }

pre { line-height: 1.3em; }

pre, .mw-code { white-space: pre; overflow-x: auto; }
