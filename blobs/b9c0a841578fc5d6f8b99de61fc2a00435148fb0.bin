ul.permissions-errors > li { list-style: none; }

span.mwe-math-mathml-inline { font-size: 118%; }

.mwe-math-fallback-image-display, .mwe-math-mathml-display { margin-top: 0.=
6em; margin-bottom: 0.6em; margin-left: 1.6em !important; }

.mwe-math-mathml-display math { display: inline; }

@media screen {
  body:not(.ns-0):not(.ns-2):not(.ns-100) .gallerybox .thumb img { backgrou=
nd: url("//upload.wikimedia.org/wikipedia/commons/5/5d/Checker-16x16.png") =
repeat rgb(255, 255, 255); }
  #siteSub { display: block; }
  .references { font-size: 90%; }
}

