e%3E %3Cpath fill=3D%22%23fff%22 d=3D%22M4.55 19A1 1 0 0 1 3 18.13V1.87A1 1=
 0 0 1 4.55 1l12.2 8.13a1 1 0 0 1 0 1.7z%22/%3E %3C/svg%3E") center center =
no-repeat rgba(0, 0, 0, 0.8); display: block; margin: auto; width: 50px; he=
ight: 50px; border-radius: 50%; position: absolute; left: 50%; top: 50%; tr=
ansform: translate(-50%, -50%); transition: transform 120ms ease-out, backg=
round-color 120ms ease-out; }

.mw-tmh-player.audio .mw-tmh-play .mw-tmh-play-icon { background: url("data=
:image/svg+xml,%3Csvg xmlns=3D%22http://www.w3.org/2000/svg%22 width=3D%222=
