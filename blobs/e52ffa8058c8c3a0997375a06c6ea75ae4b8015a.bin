@charset "utf-8";

.mw-cite-backlink, .cite-accessibility-label { user-select: none; }

.mw-references-columns { column-width: 30em; margin-top: 0.3em; }

.mw-parser-output .mw-references-columns .references { margin-top: 0px; }

.mw-references-columns li { break-inside: avoid-column; }

ol.references { counter-reset: mw-ref-extends-parent 0 mw-references 0 list=
-item 0; }

ol.references > li { counter-increment: mw-ref-extends-parent 1 mw-referenc=
es 1; counter-reset: mw-ref-extends-child 0; }

ol.references .mw-subreference-list { margin-left: 1em; padding: 0px; }

ol.references .mw-subreference-list li { list-style: none; }

.mw-subreference-list > li::before { counter-increment: mw-ref-extends-chil=
d 1; content: counter(mw-ref-extends-parent) "." counter(mw-ref-extends-chi=
ld) ". "; }

sup.reference { unicode-bidi: isolate; white-space: nowrap; font-weight: no=
rmal; font-style: normal; }

ol.references li:target, sup.reference:target { background-color: rgb(234, =
243, 255); }

.mw-ext-cite-error { font-weight: bold; unicode-bidi: embed; }

.mw-ext-cite-error code { background-color: transparent; color: inherit; pa=
dding: 1px 2px; }

.mw-cite-dir-ltr .reference-text { direction: ltr; unicode-bidi: embed; }

.mw-cite-dir-rtl .reference-text { direction: rtl; unicode-bidi: embed; }

@media print {
  .mw-cite-backlink { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation-delay: -0.01ms !important; animation-dur=
ation: 0.01ms !important; animation-iteration-count: 1 !important; scroll-b=
ehavior: auto !important; transition-duration: 0ms !important; }
}

body { margin: 0px; }

hr { box-sizing: content-box; height: 0px; overflow: visible; }

abbr[title] { border-bottom: 1px dotted; cursor: help; }

@supports (text-decoration:underline dotted) {
  abbr[title] { border-bottom: 0px; text-decoration: underline dotted; }
}

pre, code, tt, kbd, samp { font-family: monospace, monospace; }

sub, sup { line-height: 1; }

figure { margin: 0px; }

button, input, optgroup, select, textarea { margin: 0px; }

legend { padding: 0px; }

figure[typeof~=3D"mw:File"], figure[typeof~=3D"mw:File/Frameless"] { }

.mw-body-content figure[typeof~=3D"mw:File"] > a, .mw-body-content figure[t=
ypeof~=3D"mw:File/Frameless"] > a { border: 0px; }

figure[typeof~=3D"mw:File"].mw-halign-right, figure[typeof~=3D"mw:File/Fram=
eless"].mw-halign-right { margin: 0px 0px 0.5em 0.5em; clear: right; float:=
 right; }

figure[typeof~=3D"mw:File"].mw-halign-left, figure[typeof~=3D"mw:File/Frame=
less"].mw-halign-left { margin: 0px 0.5em 0.5em 0px; clear: left; float: le=
ft; }

figure[typeof~=3D"mw:File"].mw-halign-none, figure[typeof~=3D"mw:File/Frame=
less"].mw-halign-none { clear: none; float: none; }

figure[typeof~=3D"mw:File"].mw-halign-center, figure[typeof~=3D"mw:File/Fra=
meless"].mw-halign-center { margin: 0px auto; display: table; border-collap=
se: collapse; clear: none; float: none; }

figure[typeof~=3D"mw:File"] > figcaption, figure[typeof~=3D"mw:File/Framele=
ss"] > figcaption { display: none; }

figure[typeof~=3D"mw:File/Thumb"], figure[typeof~=3D"mw:File/Frame"] { disp=
lay: table; text-align: center; border-collapse: collapse; line-height: 0; =
margin: 0.5em 0px 1.3em 1.4em; clear: right; float: right; }

.mw-body-content figure[typeof~=3D"mw:File/Thumb"] > a, .mw-body-content fi=
gure[typeof~=3D"mw:File/Frame"] > a { border: 0px; }

.mw-content-ltr figure[typeof~=3D"mw:File/Thumb"], .mw-content-ltr figure[t=
ypeof~=3D"mw:File/Frame"] { margin: 0.5em 0px 1.3em 1.4em; clear: right; fl=
oat: right; }

.mw-content-rtl figure[typeof~=3D"mw:File/Thumb"], .mw-content-rtl figure[t=
ypeof~=3D"mw:File/Frame"] { margin: 0.5em 1.4em 1.3em 0px; clear: left; flo=
at: left; }

figure[typeof~=3D"mw:File/Thumb"].mw-halign-right, figure[typeof~=3D"mw:Fil=
e/Frame"].mw-halign-right { margin: 0.5em 0px 1.3em 1.4em; clear: right; fl=
oat: right; }

figure[typeof~=3D"mw:File/Thumb"].mw-halign-left, figure[typeof~=3D"mw:File=
/Frame"].mw-halign-left { margin: 0.5em 1.4em 1.3em 0px; clear: left; float=
: left; }

figure[typeof~=3D"mw:File/Thumb"].mw-halign-none, figure[typeof~=3D"mw:File=
/Frame"].mw-halign-none { margin: 0px 0px 0.5em; clear: none; float: none; =
}

figure[typeof~=3D"mw:File/Thumb"].mw-halign-center, figure[typeof~=3D"mw:Fi=
le/Frame"].mw-halign-center { margin: 0px auto 0.5em; clear: none; float: n=
one; }

figure[typeof~=3D"mw:File/Thumb"] > :not(figcaption), figure[typeof~=3D"mw:=
File/Frame"] > :not(figcaption) { }

figure[typeof~=3D"mw:File/Thumb"] > :not(figcaption) .mw-file-element, figu=
re[typeof~=3D"mw:File/Frame"] > :not(figcaption) .mw-file-element { margin:=
 3px; }

figure[typeof~=3D"mw:File/Thumb"] > :not(figcaption) .mw-broken-media, figu=
re[typeof~=3D"mw:File/Frame"] > :not(figcaption) .mw-broken-media { display=
: inline-block; line-height: 1.6em; word-break: break-word; width: 180px; f=
ont-size: 94%; }

figure[typeof~=3D"mw:File/Thumb"] > figcaption, figure[typeof~=3D"mw:File/F=
rame"] > figcaption { display: table-caption; caption-side: bottom; backgro=
und-color: inherit; line-height: 1.4em; word-break: break-word; text-align:=
 start; padding: 0px 6px 6px; }

@media (max-width: 639px) {
  body.skin--responsive figure { margin: 0px auto !important; float: none !=
important; }
}

figure[typeof~=3D"mw:File/Frame"] > figcaption:empty { padding-bottom: 0px;=
 }

figure[typeof~=3D"mw:File/Thumb"] > figcaption:empty { padding-bottom: 3px;=
 }

.mw-valign-middle .mw-file-element { vertical-align: middle; }

.mw-valign-baseline .mw-file-element { vertical-align: baseline; }

.mw-valign-sub .mw-file-element { vertical-align: sub; }

.mw-valign-super .mw-file-element { vertical-align: super; }

.mw-valign-top .mw-file-element { vertical-align: top; }

.mw-valign-text-top .mw-file-element { vertical-align: text-top; }

.mw-valign-bottom .mw-file-element { vertical-align: bottom; }

.mw-valign-text-bottom .mw-file-element { vertical-align: text-bottom; }

.toctogglecheckbox:checked ~ ul { display: none; }

.tocnumber { padding-left: 0px; padding-right: 0.5em; padding-inline: 0px 0=
.5em; }

.mw-wiki-logo { background-image: url("/w/resources/assets/NESdevWikiLogo7.=
png?446da"); }

@media print {
  figure[typeof~=3D"mw:File/Thumb"], figure[typeof~=3D"mw:File/Frame"] { bo=
rder-width: 1pt 1pt 0px; border-style: initial; border-color: initial; bord=
er-image: initial; background-color: rgb(255, 255, 255); }
  figure[typeof~=3D"mw:File/Thumb"] > :not(figcaption) .mw-file-element, fi=
gure[typeof~=3D"mw:File/Frame"] > :not(figcaption) .mw-file-element { borde=
r: 1pt solid rgb(221, 221, 221); }
  figure[typeof~=3D"mw:File/Thumb"] > figcaption, figure[typeof~=3D"mw:File=
/Frame"] > figcaption { background-color: rgb(255, 255, 255); color: rgb(10=
2, 102, 102); font-size: 10pt; border-width: 0px 1pt 1pt; border-style: ini=
tial; border-color: initial; border-image: initial; }
  .mw-image-border .mw-file-element { border: 1pt; }
  .mw-parser-output a.external { }
  .mw-parser-output a.external.text::after, .mw-parser-output a.external.au=
tonumber::after { content: ' (' attr(href) ')'; word-break: break-all; over=
flow-wrap: break-word; }
  .mw-parser-output a.external.text[href^=3D"//"]::after, .mw-parser-output=
 a.external.autonumber[href^=3D"//"]::after { content: ' (https:' attr(href=
) ')'; }
  .wikitable { background: rgb(255, 255, 255); margin: 1em 0px; border: 1pt=
 solid rgb(170, 170, 170); border-collapse: collapse; font-size: 10pt; brea=
k-inside: avoid; }
  .wikitable > caption { padding: 5px; font-size: 10pt; }
  .wikitable > tr > th, .wikitable > tr > td, .wikitable > * > tr > th, .wi=
kitable > * > tr > td { border: 1pt solid rgb(170, 170, 170); padding: 0.4e=
m 0.6em; background: rgb(255, 255, 255) !important; color: rgb(0, 0, 0) !im=
portant; }
  .wikitable > tr > th, .wikitable > * > tr > th { text-align: center; }
  table.listing, table.listing td { border: 1pt solid rgb(0, 0, 0); border-=
collapse: collapse; }
  .catlinks ul { display: inline; padding: 0px; list-style: none; }
  .catlinks li { display: inline-block; line-height: 1.15; margin: 0.1em 0p=
x; border-left: 1pt solid rgb(170, 170, 170); padding: 0px 0.4em; }
  .catlinks li:first-child { border-left: 0px; padding-left: 0.2em; }
  .mw-hidden-catlinks, .catlinks { display: none; }
  .mw-editsection, .mw-editsection-like, .mw-indicators, .mw-redirectedfrom=
, #siteNotice, .usermessage { display: none; }
  .printfooter { clear: both; padding: 1em 0px; }
  .center { text-align: center; }
  a { background: none !important; padding: 0px !important; }
  a, a.external, a.new, a.stub { color: inherit !important; text-decoration=
: inherit !important; }
  dt { font-weight: bold; }
  .mw-heading, h1, h2, h3, h4, h5, h6 { font-weight: bold; break-after: avo=
id; }
  p { margin: 1em 0px; line-height: 1.2; orphans: 3; widows: 3; }
  img, figure { break-inside: avoid; }
  img { border: 0px; vertical-align: middle; }
  pre, .mw-code { background: rgb(255, 255, 255); color: rgb(0, 0, 0); bord=
er: 1pt dashed rgb(0, 0, 0); padding: 1em; font-size: 8pt; white-space: pre=
-wrap; overflow-x: hidden; overflow-wrap: break-word; }
  ul { list-style-type: square; }
  .toctogglecheckbox:checked + .toctitle { display: none; }
  .toc { background-color: rgb(249, 249, 249); border: 1pt solid rgb(170, 1=
70, 170); padding: 5px; display: table; }
  .tocnumber, .toctext { display: table-cell; }
}

@media screen {
  figure[typeof~=3D"mw:File/Thumb"], figure[typeof~=3D"mw:File/Frame"] { bo=
rder-width: 1px 1px 0px; border-top-style: solid; border-right-style: solid=
; border-left-style: solid; border-top-color: rgb(204, 204, 204); border-ri=
ght-color: rgb(204, 204, 204); border-left-color: rgb(204, 204, 204); borde=
r-image: initial; border-bottom-style: initial; border-bottom-color: initia=
l; background-color: rgb(249, 249, 249); color: rgb(0, 0, 0); }
  figure[typeof~=3D"mw:File/Thumb"] > :not(figcaption) .mw-file-element, fi=
gure[typeof~=3D"mw:File/Frame"] > :not(figcaption) .mw-file-element { backg=
round-color: rgb(255, 255, 255); border: 1px solid rgb(204, 204, 204); }
  figure[typeof~=3D"mw:File/Thumb"] > :not(figcaption) .mw-file-element:not=
(.mw-broken-media), figure[typeof~=3D"mw:File/Frame"] > :not(figcaption) .m=
w-file-element:not(.mw-broken-media) { background-color: rgb(255, 255, 255)=
; color: rgb(34, 34, 34); }
